{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kuroii Host Heartbeat",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "Offline",
        "Connected",
        "Busy",
        "WaitingForConfirmation",
        "Executing",
        "Error",
        "Updating"
      ]
    },
    "projectId": {
      "type": "string"
    },
    "projectName": {
      "type": "string"
    },
    "context": {
      "type": "object"
    }
  }
}
