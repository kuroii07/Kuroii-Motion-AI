{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kuroii Host Registration",
  "type": "object",
  "required": [
    "extensionId",
    "projectId",
    "projectName",
    "agentVersion"
  ],
  "properties": {
    "extensionId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "projectName": {
      "type": "string"
    },
    "hostVersion": {
      "type": "string"
    },
    "agentVersion": {
      "type": "string"
    },
    "connectionMode": {
      "enum": [
        "mock",
        "live",
        "queue",
        "project-package"
      ]
    },
    "context": {
      "type": "object"
    }
  }
}
